# Database Connection (REQUIRED - Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Google OAuth Credentials (REQUIRED for Google Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional Overrides (Auto-detected from Vercel / domain if omitted)
# BETTER_AUTH_SECRET=optional_custom_secret_key_min_32_chars
# BETTER_AUTH_URL=https://gowider.in
# NEXT_PUBLIC_APP_URL=https://gowider.in
# REPORT_PEPPER_SECRET=optional_custom_pepper_min_32_chars

