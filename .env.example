# ==============================================================================
# GoWider — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# Public Application URL (Used for Canonical URLs, OpenGraph, and OAuth redirects)
# Development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production:
# NEXT_PUBLIC_APP_URL="https://gowider.in"


# ------------------------------------------------------------------------------
# 1. Authoritative Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Development (Local Docker Compose):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gowider"
# Production (Managed external PostgreSQL e.g. Neon, AWS RDS, Supabase):
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Queue & Background Workers (Redis & BullMQ)
# ------------------------------------------------------------------------------
# Development:
REDIS_URL="redis://127.0.0.1:6379"
# Production (Internal Docker network):
# REDIS_URL="redis://redis:6379"
GENERATION_WORKER_CONCURRENCY=3

# ------------------------------------------------------------------------------
# 3. Media Storage (Local / Cloudflare R2)
# ------------------------------------------------------------------------------
# Development ("local"):
STORAGE_DRIVER=local
# Production ("r2"):
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 4. Authentication (NextAuth / Auth.js v5)
# ------------------------------------------------------------------------------
AUTH_SECRET="your-32-char-random-secret"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 5. AI Voice Localization Provider (Sarvam AI)
# ------------------------------------------------------------------------------
SARVAM_API_KEY="your-sarvam-api-key"

# ------------------------------------------------------------------------------
# 6. Payments & Billing (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
